#!/usr/bin/env bash
# Color the terminal backdrop with a named color from share/colors.tsv.
# Bash 3.2 compatible. A skill asks the model to pick; this command applies it.
set -eu

ROOT="$(cd "$(dirname -- "$0")/.." && pwd)"
COLORS="$ROOT/share/colors.tsv"
MARKER_BEGIN="# >>> harness-tint >>>"
MARKER_END="# <<< harness-tint <<<"
SKILL_NAME="terminal-color"

COLOR_IDS=()
COLOR_NAMES=()
COLOR_HEXES=()
FAM=()
SHADE_N=()
FAMILY_ORDER=""
COLORS_LOADED=0

log() {
  if [ "${HARNESS_TINT_VERBOSE:-}" = "1" ]; then
    printf 'harness-tint: %s\n' "$*" >&2
  fi
}

note() {
  printf 'harness-tint: %s\n' "$*" >&2
}

die() {
  printf 'harness-tint: %s\n' "$*" >&2
  exit 1
}

lower() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

is_harness() {
  case "$1" in
    codex|claude|grok|agy|muse|prime) return 0 ;;
    *) return 1 ;;
  esac
}

home_dir() {
  printf '%s\n' "${HARNESS_TINT_HOME:-$HOME}"
}

state_root() {
  if [ -n "${HARNESS_TINT_STATE_DIR:-}" ]; then
    printf '%s\n' "$HARNESS_TINT_STATE_DIR"
    return
  fi
  local base="${XDG_STATE_HOME:-$(home_dir)/.local/state}"
  printf '%s\n' "$base/harness-tint"
}

current_tty() {
  if [ -n "${HARNESS_TINT_TTY:-}" ]; then
    printf '%s\n' "$HARNESS_TINT_TTY"
    return 0
  fi
  if [ -r /dev/tty ]; then
    local t
    # Opening /dev/tty prints "Device not configured" from the shell itself
    # when this process has no controlling terminal. Keep that off stderr.
    t="$( (tty </dev/tty) 2>/dev/null || true)"
    if [ -n "$t" ] && [ "$t" != "not a tty" ]; then
      printf '%s\n' "$t"
      return 0
    fi
  fi
  return 1
}

tty_key() {
  local t
  t="$(current_tty)" || return 1
  printf '%s\n' "$t" | tr '/' '_'
}

session_dir() {
  local key
  key="$(tty_key)" || return 1
  printf '%s\n' "$(state_root)/$key"
}

backend_name() {
  if [ -n "${HARNESS_TINT_BACKEND:-}" ]; then
    printf '%s\n' "$HARNESS_TINT_BACKEND"
    return
  fi
  case "${TERM_PROGRAM:-}" in
    Apple_Terminal) printf '%s\n' apple; return ;;
    iTerm.app|ghostty|WezTerm|alacritty) printf '%s\n' osc; return ;;
  esac
  if [ -n "${KITTY_WINDOW_ID:-}" ] || [ -n "${WEZTERM_PANE:-}" ]; then
    printf '%s\n' osc
    return
  fi
  printf '%s\n' none
}

# --- catalog ---------------------------------------------------------------

load_colors() {
  [ "$COLORS_LOADED" = 1 ] && return 0
  [ -f "$COLORS" ] || die "missing color catalog: $COLORS"
  local id name hex fam sh i
  while IFS="$(printf '\t')" read -r id name hex _; do
    case "$id" in
      ""|\#*) continue ;;
    esac
    [ -n "${hex:-}" ] || continue
    case "$id" in
      *-ink) fam="${id%-ink}"; sh=0 ;;
      *-deep) fam="${id%-deep}"; sh=1 ;;
      *-soft) fam="${id%-soft}"; sh=3 ;;
      *-glow) fam="${id%-glow}"; sh=4 ;;
      *) fam="$id"; sh=2 ;;
    esac
    i=${#COLOR_IDS[@]}
    COLOR_IDS[$i]="$id"
    COLOR_NAMES[$i]="$name"
    COLOR_HEXES[$i]="$hex"
    FAM[$i]="$fam"
    SHADE_N[$i]="$sh"
    case " $FAMILY_ORDER " in
      *" $fam "*) ;;
      *) FAMILY_ORDER="$FAMILY_ORDER $fam" ;;
    esac
  done <"$COLORS"
  [ "${#COLOR_IDS[@]}" -gt 0 ] || die "color catalog is empty"
  COLORS_LOADED=1
}

lookup_color() {
  local q="$1" i id name
  q="$(printf '%s' "$q" | tr '[:upper:]' '[:lower:]' | tr -s '[:space:]' ' ')"
  q="${q# }"
  q="${q% }"
  [ -n "$q" ] || return 1
  i=0
  while [ "$i" -lt "${#COLOR_IDS[@]}" ]; do
    id="$(lower "${COLOR_IDS[$i]}")"
    name="$(lower "${COLOR_NAMES[$i]}")"
    if [ "$q" = "$id" ] || [ "$q" = "$name" ]; then
      printf '%s\n' "$i"
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}

collect_used() {
  local root
  USED_HEXES=""
  root="$(state_root)"
  [ -d "$root" ] || return 0
  USED_HEXES="$(find "$root" -path '*/frames/*/hex' -type f -exec cat {} + 2>/dev/null || true)"
}

hex_used() {
  [ -n "${USED_HEXES:-}" ] || return 1
  case "
${USED_HEXES}
" in
    *"
$1
"*) return 0 ;;
  esac
  return 1
}

# Free colors are ordered by shade, then hue, then rotated per terminal so
# two tabs do not both start on the same name.
build_free_indexes() {
  local shade fam i
  FREE_IDX=()
  collect_used
  shade=0
  while [ "$shade" -le 4 ]; do
    for fam in $FAMILY_ORDER; do
      i=0
      while [ "$i" -lt "${#COLOR_IDS[@]}" ]; do
        if [ "${FAM[$i]}" = "$fam" ] && [ "${SHADE_N[$i]}" = "$shade" ]; then
          if ! hex_used "${COLOR_HEXES[$i]}"; then
            FREE_IDX[${#FREE_IDX[@]}]="$i"
          fi
        fi
        i=$((i + 1))
      done
    done
    shade=$((shade + 1))
  done
}

tty_slot() {
  local count="$1" key n
  key="$(current_tty 2>/dev/null || printf 'none')"
  n="$(printf '%s' "$key" | cksum | awk '{print $1}')"
  printf '%s\n' "$((n % count))"
}

hex_channels() {
  local hex="${1#\#}" r g b
  r=$((16#${hex:0:2}))
  g=$((16#${hex:2:2}))
  b=$((16#${hex:4:2}))
  printf '%s %s %s\n' "$r" "$g" "$b"
}

# --- terminal backends -----------------------------------------------------

run_bounded() {
  local pid i=0
  "$@" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    i=$((i + 1))
    if [ "$i" -gt 40 ]; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      return 124
    fi
    sleep 0.1
  done
  set +e
  wait "$pid"
  local status=$?
  set -e
  return "$status"
}

apple_invoke() {
  local mode="$1" tty_path="$2" r16="${3:-}" g16="${4:-}" b16="${5:-}" title="${6:-}"
  run_bounded /usr/bin/osascript - "$mode" "$tty_path" "$r16" "$g16" "$b16" "$title" <<'APPLESCRIPT'
on run argv
  set mode to item 1 of argv
  set targetTty to item 2 of argv
  tell application "Terminal"
    repeat with w in windows
      repeat with t in tabs of w
        try
          set tabTty to tty of t
          set bare to tabTty
          if bare begins with "/dev/" then set bare to text 6 thru -1 of bare
          set want to targetTty
          if want begins with "/dev/" then set want to text 6 thru -1 of want
          if bare is want then
            if mode is "get" then
              set bg to background color of t
              set titleText to ""
              try
                set titleText to custom title of t
              end try
              if titleText is missing value then set titleText to ""
              return (item 1 of bg as text) & " " & (item 2 of bg as text) & " " & (item 3 of bg as text) & linefeed & titleText
            else
              set background color of t to {(item 3 of argv) as integer, (item 4 of argv) as integer, (item 5 of argv) as integer}
              return "ok"
            end if
          end if
        end try
      end repeat
    end repeat
  end tell
  error "no Terminal tab for " & targetTty
end run
APPLESCRIPT
}

osc_set() {
  local hex="$1"
  [ -w /dev/tty ] || return 1
  printf '\033]11;%s\007' "$hex" >/dev/tty
}

osc_reset() {
  [ -w /dev/tty ] || return 1
  printf '\033]111\007' >/dev/tty
}

dry_log() {
  printf '%s\n' "${HARNESS_TINT_DRY_LOG:-$(state_root)/dry.log}"
}

backend_get() {
  local backend
  backend="$(backend_name)"
  case "$backend" in
    dry)
      printf '%s\n' "${HARNESS_TINT_DRY_ORIGINAL:-257 514 771}"
      printf '\n'
      ;;
    apple)
      apple_invoke get "$(current_tty)"
      ;;
    osc|none)
      return 2
      ;;
    *)
      return 1
      ;;
  esac
}

backend_set() {
  local hex="$1" title="${2:-}" backend r g b r16 g16 b16
  backend="$(backend_name)"
  read -r r g b <<EOF
$(hex_channels "$hex")
EOF
  r16=$((r * 257))
  g16=$((g * 257))
  b16=$((b * 257))
  case "$backend" in
    dry)
      mkdir -p "$(dirname -- "$(dry_log)")"
      printf 'set %s %s\n' "$hex" "$title" >>"$(dry_log)"
      ;;
    apple)
      apple_invoke set "$(current_tty)" "$r16" "$g16" "$b16" "$title" >/dev/null
      ;;
    osc)
      osc_set "$hex"
      ;;
    none)
      log "no backdrop backend for this terminal"
      return 1
      ;;
    *)
      return 1
      ;;
  esac
}

backend_reset() {
  local title="$1" backend r g b
  backend="$(backend_name)"
  case "$backend" in
    dry)
      mkdir -p "$(dirname -- "$(dry_log)")"
      printf 'reset %s\n' "$title" >>"$(dry_log)"
      ;;
    apple)
      read -r r g b <<EOF
$(cat "$(session_dir)/original_rgb")
EOF
      apple_invoke set "$(current_tty)" "$r" "$g" "$b" "$title" >/dev/null
      ;;
    osc)
      osc_reset
      ;;
    none)
      return 0
      ;;
  esac
}

# --- session stack ---------------------------------------------------------

acquire_lock() {
  local dir="$1" i=0
  mkdir -p "$dir"
  while ! mkdir "$dir/lock" 2>/dev/null; do
    i=$((i + 1))
    if [ "$i" -gt 50 ]; then
      return 1
    fi
    sleep 0.05
  done
}

release_lock() {
  rmdir "$1/lock" 2>/dev/null || true
}

top_frame_name() {
  local dir="$1" name=""
  [ -d "$dir/frames" ] || return 1
  name="$(find "$dir/frames" -mindepth 1 -maxdepth 1 -type d -exec basename -- {} \; 2>/dev/null | sort | tail -n 1)"
  [ -n "$name" ] || return 1
  printf '%s\n' "$name"
}

read_frame() {
  local frame="$1" field="$2"
  [ -f "$frame/$field" ] || return 1
  cat "$frame/$field"
}

next_frame_name() {
  local dir="$1" n=0 d
  mkdir -p "$dir/frames"
  for d in "$dir/frames"/*; do
    [ -d "$d" ] || continue
    n=$((n + 1))
  done
  n=$((n + 1))
  printf '%04d\n' "$n"
}

save_original_if_needed() {
  local dir="$1" backend raw r title
  [ -f "$dir/original_saved" ] && return 0
  backend="$(backend_name)"
  printf '%s\n' "$backend" >"$dir/backend"
  if [ "$backend" = "osc" ] || [ "$backend" = "none" ]; then
    : >"$dir/original_title"
    : >"$dir/original_rgb"
    : >"$dir/original_saved"
    return 0
  fi
  raw="$(backend_get)" || return 1
  r="$(printf '%s\n' "$raw" | head -n 1)"
  title="$(printf '%s\n' "$raw" | tail -n +2)"
  printf '%s\n' "$r" >"$dir/original_rgb"
  printf '%s' "$title" >"$dir/original_title"
  : >"$dir/original_saved"
}

previous_frame() {
  local dir="$1" cur="$2" base last=""
  for base in $(find "$dir/frames" -mindepth 1 -maxdepth 1 -type d -exec basename -- {} \; 2>/dev/null | sort); do
    if [ "$base" = "$cur" ]; then
      printf '%s\n' "$last"
      return 0
    fi
    last="$base"
  done
  return 1
}

# Hex and display name of `from` or the nearest older frame that has a color.
color_at_or_below() {
  local dir="$1" from="$2" base
  for base in $(find "$dir/frames" -mindepth 1 -maxdepth 1 -type d -exec basename -- {} \; 2>/dev/null | sort -r); do
    if [ "$base" \> "$from" ]; then
      continue
    fi
    if [ -s "$dir/frames/$base/hex" ]; then
      cat "$dir/frames/$base/hex"
      if [ -s "$dir/frames/$base/name" ]; then
        cat "$dir/frames/$base/name"
      else
        printf '\n'
      fi
      return 0
    fi
  done
  return 1
}

_hold_frame() {
  local dir="$1" harness="$2" name
  save_original_if_needed "$dir" || return 1
  name="$(next_frame_name "$dir")"
  mkdir -p "$dir/frames/$name"
  printf '%s\n' "$harness" >"$dir/frames/$name/harness"
}

hold_session() {
  local harness="$1" dir status=0
  dir="$(session_dir)" || return 1
  acquire_lock "$dir" || return 1
  set +e
  _hold_frame "$dir" "$harness"
  status=$?
  set -e
  release_lock "$dir"
  return "$status"
}

_apply_index() {
  local dir="$1" idx="$2" frame id name hex
  id="${COLOR_IDS[$idx]}"
  name="${COLOR_NAMES[$idx]}"
  hex="${COLOR_HEXES[$idx]}"
  save_original_if_needed "$dir" || return 1
  frame="$(top_frame_name "$dir" || true)"
  if [ -z "$frame" ]; then
    frame="$(next_frame_name "$dir")"
    mkdir -p "$dir/frames/$frame"
    printf '%s\n' "picked" >"$dir/frames/$frame/harness"
  fi
  backend_set "$hex" "$name" || return 1
  printf '%s\n' "$id" >"$dir/frames/$frame/color_id"
  printf '%s\n' "$name" >"$dir/frames/$frame/name"
  printf '%s\n' "$hex" >"$dir/frames/$frame/hex"
}

apply_index() {
  local idx="$1" dir status=0
  dir="$(session_dir)" || return 1
  acquire_lock "$dir" || return 1
  set +e
  _apply_index "$dir" "$idx"
  status=$?
  set -e
  release_lock "$dir"
  return "$status"
}

_pop_frame() {
  local dir="$1" harness="$2" frame top_harness popped="" next restored title name hex
  frame="$(top_frame_name "$dir" || true)"
  [ -n "$frame" ] || return 0
  top_harness="$(read_frame "$dir/frames/$frame" harness || true)"
  if [ -n "$harness" ] && [ "$top_harness" != "$harness" ]; then
    log "top frame is $top_harness, leaving it in place"
    return 0
  fi
  if [ -s "$dir/frames/$frame/hex" ]; then
    popped="$(cat "$dir/frames/$frame/hex")"
  fi
  rm -rf "$dir/frames/$frame"
  next="$(top_frame_name "$dir" || true)"
  if [ -n "$next" ]; then
    if restored="$(color_at_or_below "$dir" "$next")"; then
      hex="$(printf '%s\n' "$restored" | head -n 1)"
      name="$(printf '%s\n' "$restored" | tail -n +2)"
      backend_set "$hex" "$name" || true
    elif [ -n "$popped" ]; then
      title="$(cat "$dir/original_title" 2>/dev/null || true)"
      backend_reset "$title" || true
    fi
    return 0
  fi
  if [ -n "$popped" ]; then
    title="$(cat "$dir/original_title" 2>/dev/null || true)"
    backend_reset "$title" || true
  fi
  rm -rf "$dir"
}

pop_frame() {
  local harness="$1" dir status=0
  dir="$(session_dir)" || return 0
  [ -d "$dir" ] || return 0
  acquire_lock "$dir" || return 1
  set +e
  _pop_frame "$dir" "$harness"
  status=$?
  set -e
  release_lock "$dir"
  return "$status"
}

with_catalog_lock() {
  local root status=0
  root="$(state_root)"
  acquire_lock "$root" || return 1
  set +e
  "$@"
  status=$?
  set -e
  release_lock "$root"
  return "$status"
}

# --- commands --------------------------------------------------------------

cmd_list() {
  local free=0 start count k idx
  load_colors
  if [ "${1:-}" = "--free" ]; then
    free=1
  fi
  if [ "$free" = 0 ]; then
    idx=0
    while [ "$idx" -lt "${#COLOR_IDS[@]}" ]; do
      printf '%s\t%s\t%s\n' "${COLOR_IDS[$idx]}" "${COLOR_NAMES[$idx]}" "${COLOR_HEXES[$idx]}"
      idx=$((idx + 1))
    done
    return 0
  fi
  build_free_indexes
  count=${#FREE_IDX[@]}
  [ "$count" -gt 0 ] || return 0
  start="$(tty_slot "$count")"
  k=0
  while [ "$k" -lt "$count" ]; do
    idx="${FREE_IDX[$(( (start + k) % count ))]}"
    printf '%s\t%s\t%s\n' "${COLOR_IDS[$idx]}" "${COLOR_NAMES[$idx]}" "${COLOR_HEXES[$idx]}"
    k=$((k + 1))
  done
}

cmd_use() {
  local q="$*" idx
  [ -n "$q" ] || die "use needs a color name"
  load_colors
  idx="$(lookup_color "$q")" || die "unknown color '$q'. Run: harness-tint list"
  apply_index "$idx" || die "could not color this terminal"
  printf '%s\n' "${COLOR_NAMES[$idx]}"
}

_cmd_pick() {
  local count start idx
  load_colors
  build_free_indexes
  count=${#FREE_IDX[@]}
  if [ "$count" -eq 0 ]; then
    return 2
  fi
  start="$(tty_slot "$count")"
  idx="${FREE_IDX[$start]}"
  apply_index "$idx" || return 1
  printf '%s\n' "${COLOR_NAMES[$idx]}"
}

cmd_pick() {
  local status=0
  set +e
  with_catalog_lock _cmd_pick
  status=$?
  set -e
  case "$status" in
    0) return 0 ;;
    2) die "no free colors" ;;
    *) die "could not color this terminal" ;;
  esac
}

cmd_current() {
  local dir frame name
  dir="$(session_dir 2>/dev/null || true)"
  if [ -z "${dir:-}" ] || [ ! -d "$dir/frames" ]; then
    printf 'none\n'
    return 0
  fi
  frame="$(top_frame_name "$dir" || true)"
  while [ -n "$frame" ]; do
    if [ -s "$dir/frames/$frame/name" ]; then
      cat "$dir/frames/$frame/name"
      return 0
    fi
    name="$(previous_frame "$dir" "$frame" || true)"
    frame="$name"
  done
  printf 'none\n'
}

cmd_restore() {
  pop_frame "${1:-}"
}

cmd_wrap() {
  local harness="${1:-}"
  shift || true
  if [ "${1:-}" = "--" ]; then
    shift
  fi
  is_harness "$harness" || die "wrap needs a harness and a command"
  [ "$#" -gt 0 ] || die "wrap needs a command after --"
  local arg status=0
  for arg in "$@"; do
    case "$arg" in
      -h|--help|--version|-V)
        set +e
        "$@"
        status=$?
        set -e
        return "$status"
        ;;
    esac
  done
  if [ "${HARNESS_TINT_DISABLE:-}" = "1" ]; then
    set +e
    "$@"
    status=$?
    set -e
    return "$status"
  fi
  local cleaned=0
  if ! hold_session "$harness"; then
    log "backdrop unchanged"
  fi
  cleanup() {
    if [ "$cleaned" -eq 1 ]; then
      return
    fi
    cleaned=1
    pop_frame "$harness" || true
  }
  trap cleanup EXIT INT TERM
  set +e
  "$@"
  status=$?
  set -e
  cleanup
  trap - EXIT INT TERM
  return "$status"
}

cmd_preview() {
  local idx=0 r g b
  load_colors
  while [ "$idx" -lt "${#COLOR_IDS[@]}" ]; do
    read -r r g b <<EOF
$(hex_channels "${COLOR_HEXES[$idx]}")
EOF
    printf '\033[48;2;%d;%d;%dm  %-16s \033[0m %s\n' \
      "$r" "$g" "$b" "${COLOR_NAMES[$idx]}" "${COLOR_HEXES[$idx]}"
    idx=$((idx + 1))
  done
}

cmd_doctor() {
  local backend tty_path="" file label dest
  backend="$(backend_name)"
  printf 'backend: %s\n' "$backend"
  if tty_path="$(current_tty)"; then
    printf 'tty: %s\n' "$tty_path"
  else
    printf 'tty: none\n'
  fi
  if [ "$backend" = "apple" ] && [ -n "$tty_path" ]; then
    if apple_invoke get "$tty_path" >/dev/null 2>&1; then
      printf 'terminal tab: matched\n'
    else
      printf 'terminal tab: not matched\n'
    fi
  fi
  load_colors
  printf 'colors: %s\n' "${#COLOR_IDS[@]}"
  printf 'current: %s\n' "$(cmd_current)"
  file="$(zshrc_file)"
  if [ -f "$file" ] && grep -q "$MARKER_BEGIN" "$file"; then
    printf 'shell: wired in %s\n' "$file"
  else
    printf 'shell: not wired\n'
  fi
  if auto_tint_present; then
    printf 'auto-tint: still installed\n'
  else
    printf 'auto-tint: off\n'
  fi
  for label in grok claude codex agy prime muse; do
    dest="$(skill_dest "$label")"
    if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$(skill_canonical)" ]; then
      printf 'skill %s: linked\n' "$label"
    elif [ -e "$dest" ] || [ -L "$dest" ]; then
      printf 'skill %s: present\n' "$label"
    else
      printf 'skill %s: not linked\n' "$label"
    fi
  done
}

auto_tint_present() {
  local file
  file="$(grok_config_file)"
  if [ -f "$file" ] && grep -q "$MARKER_BEGIN" "$file"; then
    return 0
  fi
  file="$(claude_settings_file)"
  if [ -f "$file" ] && grep -q "harness-tint on-event claude" "$file"; then
    return 0
  fi
  file="$(codex_hooks_file)"
  if [ -f "$file" ] && grep -q "harness-tint on-event codex" "$file"; then
    return 0
  fi
  file="$(agy_settings_file)"
  if [ -f "$file" ] && grep -q "harness-tint on-statusline agy" "$file"; then
    return 0
  fi
  return 1
}

# --- install ---------------------------------------------------------------

bin_path() {
  printf '%s\n' "$ROOT/bin/harness-tint"
}

skill_canonical() {
  printf '%s\n' "$ROOT/skills/$SKILL_NAME"
}

zshrc_file() {
  printf '%s\n' "${HARNESS_TINT_ZSHRC:-$(home_dir)/.zshrc}"
}

claude_settings_file() {
  printf '%s\n' "${HARNESS_TINT_CLAUDE_SETTINGS:-$(home_dir)/.claude/settings.json}"
}

grok_config_file() {
  printf '%s\n' "${HARNESS_TINT_GROK_CONFIG:-$(home_dir)/.grok/config.toml}"
}

agy_settings_file() {
  printf '%s\n' "${HARNESS_TINT_AGY_SETTINGS:-$(home_dir)/.gemini/antigravity-cli/settings.json}"
}

codex_hooks_file() {
  if [ -n "${HARNESS_TINT_CODEX_HOOKS:-}" ]; then
    printf '%s\n' "$HARNESS_TINT_CODEX_HOOKS"
  elif [ -n "${HARNESS_TINT_HOME:-}" ]; then
    printf '%s\n' "$(home_dir)/.codex/hooks.json"
  else
    printf '%s\n' "${CODEX_HOME:-$HOME/.codex}/hooks.json"
  fi
}

skill_dest() {
  local label="$1"
  case "$label" in
    grok) printf '%s\n' "$(home_dir)/.grok/skills/$SKILL_NAME" ;;
    claude) printf '%s\n' "$(home_dir)/.claude/skills/$SKILL_NAME" ;;
    codex)
      if [ -n "${HARNESS_TINT_HOME:-}" ]; then
        printf '%s\n' "$(home_dir)/.codex/skills/$SKILL_NAME"
      else
        printf '%s\n' "${CODEX_HOME:-$HOME/.codex}/skills/$SKILL_NAME"
      fi
      ;;
    agy) printf '%s\n' "$(home_dir)/.gemini/config/skills/$SKILL_NAME" ;;
    prime) printf '%s\n' "$(home_dir)/.prime/agent/skills/$SKILL_NAME" ;;
    muse)
      if [ -n "${HARNESS_TINT_HOME:-}" ] || [ -z "${XDG_CONFIG_HOME:-}" ]; then
        printf '%s\n' "$(home_dir)/.config/muse/skills/$SKILL_NAME"
      else
        printf '%s\n' "$XDG_CONFIG_HOME/muse/skills/$SKILL_NAME"
      fi
      ;;
    *) return 1 ;;
  esac
}

replace_marked_block() {
  local file="$1" block="$2" tmp
  tmp="$(mktemp)"
  if [ -f "$file" ] && grep -q "$MARKER_BEGIN" "$file"; then
    awk -v begin="$MARKER_BEGIN" -v end="$MARKER_END" '
      $0 == begin { skip = 1; next }
      $0 == end { skip = 0; next }
      skip != 1 { print }
    ' "$file" >"$tmp"
  elif [ -f "$file" ]; then
    cat "$file" >"$tmp"
  else
    : >"$tmp"
  fi
  if [ -s "$tmp" ]; then
    trimmed="$(mktemp)"
    awk '
      { lines[NR] = $0 }
      END {
        n = NR
        while (n > 0 && lines[n] == "") n--
        for (i = 1; i <= n; i++) print lines[i]
        print ""
      }
    ' "$tmp" >"$trimmed"
    mv "$trimmed" "$tmp"
  fi
  printf '%s\n' "$block" >>"$tmp"
  mkdir -p "$(dirname -- "$file")"
  mv "$tmp" "$file"
}

remove_marked_block() {
  local file="$1" tmp
  [ -f "$file" ] || return 0
  grep -q "$MARKER_BEGIN" "$file" || return 0
  tmp="$(mktemp)"
  awk -v begin="$MARKER_BEGIN" -v end="$MARKER_END" '
    $0 == begin { skip = 1; next }
    $0 == end { skip = 0; next }
    skip != 1 { print }
  ' "$file" >"$tmp"
  mv "$tmp" "$file"
}

install_shell() {
  local zshrc block
  zshrc="$(zshrc_file)"
  block="$MARKER_BEGIN
source \"$ROOT/share/zshrc.zsh\"
$MARKER_END"
  replace_marked_block "$zshrc" "$block"
  note "shell wrappers sourced from $zshrc"
}

install_link() {
  local home bindir dest
  home="$(home_dir)"
  bindir="$home/.local/bin"
  dest="$bindir/harness-tint"
  mkdir -p "$bindir"
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    note "$dest exists and is not a symlink; left it in place"
    return 0
  fi
  ln -sfn "$(bin_path)" "$dest"
  note "linked $dest"
}

install_one_skill() {
  local dest="$1" canonical
  canonical="$(skill_canonical)"
  [ -d "$canonical" ] || {
    note "skill directory missing: $canonical"
    return 0
  }
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$canonical" ]; then
      ln -sfn "$canonical" "$dest"
      return 0
    fi
    note "left existing skill at $dest"
    return 0
  fi
  mkdir -p "$(dirname -- "$dest")"
  ln -sfn "$canonical" "$dest"
}

install_skills() {
  local label
  for label in grok claude codex agy prime muse; do
    install_one_skill "$(skill_dest "$label")"
  done
  note "skill $SKILL_NAME linked for grok, claude, codex, agy, prime, and muse"
}

remove_auto_tint() {
  remove_marked_block "$(grok_config_file)"
  uninstall_json_hooks "$(claude_settings_file)" "harness-tint on-event claude"
  uninstall_json_hooks "$(codex_hooks_file)" "harness-tint on-event codex"
  uninstall_agy
}

cmd_install() {
  install_link
  install_shell
  remove_auto_tint
  install_skills
  note "open a new terminal, or run: source \"$(zshrc_file)\""
}

uninstall_json_hooks() {
  local file="$1" needle="$2"
  [ -f "$file" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$file" "$needle" <<'PY'
import json, os, sys
path, needle = sys.argv[1], sys.argv[2]
with open(path, "r", encoding="utf-8") as fh:
    data = json.load(fh)
hooks = data.get("hooks")
if isinstance(hooks, dict):
    for event, groups in list(hooks.items()):
        kept = []
        if not isinstance(groups, list):
            continue
        for group in groups:
            if not isinstance(group, dict):
                kept.append(group)
                continue
            group["hooks"] = [
                hook for hook in group.get("hooks", [])
                if needle not in hook.get("command", "")
            ]
            if group["hooks"]:
                kept.append(group)
        if kept:
            hooks[event] = kept
        else:
            del hooks[event]
    if not hooks:
        data.pop("hooks", None)
if data.get("description") == "Tint the terminal for the Codex model.":
    data.pop("description", None)
if not data:
    os.remove(path)
    raise SystemExit(0)
tmp = path + ".harness-tint.tmp"
try:
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    os.replace(tmp, path)
except Exception:
    if os.path.exists(tmp):
        os.remove(tmp)
    raise
PY
}

uninstall_agy() {
  local file
  file="$(agy_settings_file)"
  [ -f "$file" ] || return 0
  grep -q "harness-tint on-statusline agy" "$file" || return 0
  python3 - "$file" <<'PY'
import os, sys
path = sys.argv[1]
text = open(path, "r", encoding="utf-8").read()
start = text.find('  "statusLine":')
if start == -1 or "harness-tint on-statusline agy" not in text[start:start + 400]:
    raise SystemExit(0)
end = text.find("},\n", start)
if end == -1:
    raise SystemExit(0)
end += 3
tmp = path + ".harness-tint.tmp"
try:
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text[:start] + text[end:])
    os.replace(tmp, path)
except Exception:
    if os.path.exists(tmp):
        os.remove(tmp)
    raise
PY
}

remove_skill_link() {
  local dest="$1" canonical
  canonical="$(skill_canonical)"
  [ -L "$dest" ] || return 0
  if [ "$(readlink "$dest")" = "$canonical" ]; then
    rm -f "$dest"
  fi
}

cmd_uninstall() {
  local dest label
  remove_marked_block "$(zshrc_file)"
  remove_auto_tint
  for label in grok claude codex agy prime muse; do
    remove_skill_link "$(skill_dest "$label")"
  done
  dest="$(home_dir)/.local/bin/harness-tint"
  if [ -L "$dest" ]; then
    rm -f "$dest"
  fi
  note "removed shell wrappers, skill links, and any model-tint hooks"
}

usage() {
  cat <<'EOF'
Usage: harness-tint <command> [args]

  list [--free]              Print id, name, and hex. --free hides colors in use
  pick                       Apply a free color for this terminal and print its name
  use <color>                Apply a catalog color by id or name
  current                    Print the color chosen for this terminal
  preview                    Print the catalog as terminal color swatches
  restore [harness]          Pop one color and restore the previous backdrop
  wrap <harness> -- <cmd>    Remember the backdrop, run the command, restore on exit
  doctor                     Show backend, catalog, and install state
  install                    Wire shell wrappers and the terminal-color skill
  uninstall                  Remove the wrappers, skill links, and old model hooks
  help                       Show this help

The color catalog is share/colors.tsv. Wrappers do not choose a color.
HARNESS_TINT_DISABLE=1 runs a wrapped command without saving or restoring.
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    list) cmd_list "$@" ;;
    pick) cmd_pick "$@" ;;
    use) cmd_use "$@" ;;
    current) cmd_current ;;
    preview) cmd_preview ;;
    restore) cmd_restore "$@" ;;
    wrap) cmd_wrap "$@" ;;
    # Leftover model hooks from the previous install must not retint, and
    # must not print into the model's context.
    on-event|on-statusline)
      cat >/dev/null || true
      ;;
    doctor) cmd_doctor ;;
    install) cmd_install ;;
    uninstall) cmd_uninstall ;;
    help|-h|--help) usage ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
